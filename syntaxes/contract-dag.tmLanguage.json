{
  "name": "Contract DAG",
  "scopeName": "source.contractdag",
  "patterns": [
    { "include": "#comment" },
    { "include": "#region" },
    { "include": "#link-head" },
    { "include": "#node-head" },
    { "include": "#style" },
    { "include": "#key-value" }
  ],
  "repository": {
    "comment": {
      "match": "^\\s*#.*$",
      "name": "comment.line.number-sign.contractdag"
    },
    "region": {
      "match": "^\\s*(</?)(nodes|links|style)(>)",
      "name": "keyword.other.region.contractdag",
      "captures": {
        "1": { "name": "punctuation.definition.region.contractdag" },
        "3": { "name": "punctuation.definition.region.contractdag" }
      }
    },
    "link-head": {
      "begin": "^\\s*\\[\\[",
      "end": "\\]\\]",
      "name": "meta.link.contractdag",
      "patterns": [
        { "match": "->", "name": "keyword.operator.arrow.contractdag" },
        { "match": "[^\\[\\]\\s][^\\[\\]]*?(?=\\s*(?:->|\\]\\]))", "name": "entity.name.type.node.contractdag" }
      ]
    },
    "node-head": {
      "match": "^\\s*\\[([^\\[\\]]+?)(?::([^\\[\\]]+?))?\\]\\s*$",
      "captures": {
        "1": { "name": "entity.name.type.node.contractdag" },
        "2": { "name": "string.unquoted.annotation.contractdag" }
      }
    },
    "style": {
      "match": "^\\s*(direction|gap|font|classDef|class|linkStyle)\\b",
      "name": "keyword.other.style.contractdag",
      "captures": {
        "1": { "name": "keyword.other.style.contractdag" }
      }
    },
    "key-value": {
      "match": "^\\s*([A-Za-z][A-Za-z0-9_-]*)\\s*(=)\\s*(.+?)\\s*$",
      "captures": {
        "1": { "name": "variable.other.key.contractdag" },
        "2": { "name": "keyword.operator.assignment.contractdag" },
        "3": { "name": "string.unquoted.contractdag" }
      }
    }
  }
}
