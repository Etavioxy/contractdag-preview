{
  "name": "contractdag-preview",
  "displayName": "Contract DAG Preview",
  "description": "把契约声明文件画成有向无环图",
  "version": "0.1.0",
  "publisher": "contractdag",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:contract-dag"
  ],
  "contributes": {
    "commands": [
      {
        "command": "contractdag.dump",
        "title": "Contract DAG: 导出契约模型"
      },
      {
        "command": "contractdag.inspect",
        "title": "Contract DAG: 观测编辑器三样"
      },
      {
        "command": "contractdag.layout",
        "title": "Contract DAG: 计算图布局"
      },
      {
        "command": "contractdag.preview",
        "title": "Contract DAG: 打开预览",
        "icon": {
          "light": "media/icons/contract-dag-light.svg",
          "dark": "media/icons/contract-dag-dark.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "contractdag.preview",
          "when": "editorLangId == contract-dag",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "contractdag.preview",
          "when": "editorLangId == contract-dag"
        }
      ]
    },
    "languages": [
      {
        "id": "contract-dag",
        "aliases": [
          "Contract DAG",
          "contractdag"
        ],
        "extensions": [
          ".contractdag"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "contract-dag",
        "scopeName": "source.contractdag",
        "path": "./syntaxes/contract-dag.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/unit/",
    "e2e": "node scripts/build.mjs && node dist/test/e2e/host.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "d3-dag": "^1.2.2"
  }
}
